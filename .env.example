# EmailJS Configuration
# Get these values from https://dashboard.emailjs.com/

# Service ID (from Email Services section)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Template ID (from Email Templates section)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Public Key (from Account > General section)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Google Reviews carousel
# Create a restricted key with Places API (New) enabled, then add the same
# server-side variable in your Vercel project settings. Never commit the real key.
GOOGLE_PLACES_API_KEY=your_google_places_api_key
